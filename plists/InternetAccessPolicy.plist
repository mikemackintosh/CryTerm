<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>ApplicationDescription</key>
	<string>CryTerm is a free terminal emulator based on iTerm2.</string>
	<key>Connections</key>
	<array>
		<dict>
			<key>IsIncoming</key>
			<false/>
			<key>Host</key>
			<string>iterm2.com</string>
			<key>NetworkProtocol</key>
			<string>TCP</string>
			<key>Port</key>
			<string>443</string>
			<key>Relevance</key>
			<string>Default</string>
			<key>Purpose</key>
			<string>CryTerm downloads the Python runtime for the scripting API from iterm2.com.</string>
			<key>DenyConsequences</key>
			<string>If you deny this connection, you won’t be able to install or update the Python runtime for the scripting API.</string>
		</dict>
		<dict>
			<key>IsIncoming</key>
			<false/>
			<key>Host</key>
			<string>github.com</string>
			<key>NetworkProtocol</key>
			<string>TCP</string>
			<key>Port</key>
			<string>443</string>
			<key>Relevance</key>
			<string>Default</string>
			<key>Purpose</key>
			<string>CryTerm connects to github.com to check for and download software updates.</string>
			<key>DenyConsequences</key>
			<string>If you deny this connection, you won’t be notified when a new version is released.</string>
		</dict>
		<dict>
			<key>IsIncoming</key>
			<false/>
			<key>Host</key>
			<string>*</string>
			<key>NetworkProtocol</key>
			<string>TCP</string>
			<key>Purpose</key>
			<string>Applications running within CryTerm may open connections.</string>
			<key>DenyConsequences</key>
			<string>The current command will not be able to proceed.</string>
		</dict>
	</array>
</dict>
</plist>
